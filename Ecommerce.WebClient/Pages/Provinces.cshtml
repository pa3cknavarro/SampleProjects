@page
@model Ecommerce.WebClient.Pages.ProvincesModel
@{ ViewData["Title"] = "Provinces"; }
<h2>Provinces</h2>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Items is null || !Model.Items.Any())
{
    <p class="text-muted">No provinces found. Is the API running?</p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Name</th><th>Id</th><th>Created</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                <td>@p.ProvinceName</td>
                <td><code>@p.ProvinceId</code></td>
                <td>@p.CreatedOn.ToString("u")</td>
            </tr>
        }
        </tbody>
    </table>
}
