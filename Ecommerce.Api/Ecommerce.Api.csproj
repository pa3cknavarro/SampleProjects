<!--
  SDK-style project. Microsoft.NET.Sdk.Web pulls in the ASP.NET Core shared framework,
  so the API can host Kestrel, middleware, and minimal APIs without extra framework references.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Groups MSBuild properties that apply to every build of this project. -->
  <PropertyGroup>
    <!-- Compiles against .NET 8. The SDK must be able to resolve the net8.0 targeting pack. -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Turns on nullable reference types. The compiler warns when a non-nullable reference might be null. -->
    <Nullable>enable</Nullable>
    <!-- Implicitly imports common namespaces such as System, System.Linq, and the ASP.NET Core hosting namespaces. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Groups NuGet packages restored before compile. -->
  <ItemGroup>
    <!-- Adds URL-based API versioning for minimal APIs, used to map /api/v1 route groups. -->
    <PackageReference Include="Asp.Versioning.Http" Version="8.1.0" />
    <!-- Adds the API explorer integration so Swagger can list each API version. -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <!-- Carter scans the assembly for ICarterModule implementations and maps their routes. -->
    <PackageReference Include="Carter" Version="8.2.1" />
    <!-- Supplies OpenAPI document generation types that ship with ASP.NET Core 8. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.34" />
    <!-- Provides PostgreSQL persistence for the API's Entity Framework Core context. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- Enables generating and applying EF Core schema migrations without shipping design tooling transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Aligns EF design-time Roslyn dependencies with Carter's analyzer version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Swashbuckle generates the Swagger JSON and hosts the Swagger UI middleware. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Provides secure password hashing for user credentials. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
  </ItemGroup>

<!-- Closes the project file. MSBuild reads nothing further from this file. -->
</Project>
